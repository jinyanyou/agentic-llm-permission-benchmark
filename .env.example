# 원격 GPU/Ollama 접속 정보 — 실제 값은 .env 에 작성하고 절대 커밋하지 마세요.
# bootstrap.sh 가 $ROOT/.env 를 자동 로드합니다.

GPU_HOST=your.gpu.host.example.com      # SSH 접속 호스트 (IP 또는 도메인)
GPU_USER=youruser                        # SSH 계정
GPU_PORT=22                              # SSH 포트
GPU_PASS=change-me                        # SSH 비밀번호 (가능하면 키 인증 권장)
OLLAMA_REMOTE_HOST=gpu-node               # 터널 대상 노드명 (-L ...:NODE:11434)
